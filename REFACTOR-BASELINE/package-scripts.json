{
  "start": "npm run app",
  "preapp": "node scripts/ensure-deps.js",
  "app:prepare": "node scripts/build-if-needed.js",
  "app": "npm run app:prepare && node scripts/launch-electron.js",
  "app:spark": "bash ./run-devforge-spark.sh",
  "predev": "node scripts/ensure-deps.js",
  "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
  "dev:vite": "vite",
  "dev:electron": "wait-on http://localhost:5173 && electron .",
  "prebuild": "node scripts/ensure-deps.js",
  "build:app": "vite build",
  "build:native:mosaic": "node scripts/build-mosaic-coordinator.js",
  "build": "vite build && electron-builder --config electron-builder.config.cjs",
  "build:win": "vite build && electron-builder --config electron-builder.config.cjs --win",
  "build:mac": "vite build && electron-builder --config electron-builder.config.cjs --mac",
  "build:linux": "vite build && electron-builder --config electron-builder.config.cjs --linux",
  "preview": "vite preview",
  "lint": "eslint src --ext .js,.jsx",
  "ensure-deps": "node scripts/ensure-deps.js",
  "eval:research": "node scripts/research-eval.js",
  "eval:casual": "node scripts/casual-eval.js",
  "eval:coding": "node scripts/coding-eval.js",
  "eval:chat-v2": "node scripts/chat-v2-eval.js",
  "eval:llm-mode": "node scripts/llm-mode-eval.js",
  "eval:live-chat-smoke": "node scripts/live-chat-smoke.js",
  "eval:perf-chat-stream": "node scripts/perf-chat-stream.js",
  "eval:perf-db-save": "node scripts/perf-db-save.js",
  "eval:perf-ui-polling": "node scripts/perf-ui-polling.js",
  "eval:perf-gate": "node scripts/release-perf-gate.js",
  "eval:model-hub": "node scripts/model-hub-eval.js",
  "eval:model-selector": "node scripts/model-selector-catalogue-smoke.js",
  "eval:ipc-security": "node scripts/ipc-security-eval.js",
  "eval:long-context": "node scripts/long-context-eval.js",
  "eval:mode-switch": "node scripts/mode-switch-smoke.js",
  "eval:llamanode": "node scripts/llamanode-smoke.js",
  "eval:llamanode-live": "node scripts/llamanode-live-smoke.js",
  "eval:tiered-utilization": "node scripts/tiered-utilization-smoke.js",
  "eval:draft-selector": "node scripts/draft-selector-smoke.js",
  "eval:npu-draft": "node scripts/npu-draft-smoke.js",
  "eval:spec-verifier": "node scripts/spec-verifier-smoke.js",
  "eval:spec-bus": "node scripts/spec-bus-smoke.js",
  "eval:spec-dashboard": "node scripts/spec-dashboard-smoke.js",
  "eval:spec-decoding": "node scripts/speculative-decoding-eval.js",
  "eval:spec-live": "node scripts/spec-decode-live-smoke.js",
  "eval:mosaic-gate2": "node scripts/mosaic-gate2-eval.js",
  "eval:mosaic-probe": "node scripts/mosaic-runner-probe.js",
  "eval:v03-manual-qa": "node scripts/v03-manual-qa-harness.js",
  "eval:live-smoke": "node scripts/stream-cold-load-smoke.js && node scripts/npu-genai-smoke.js && node scripts/speculative-decoding-eval.js",
  "eval:baseline-v03": "node scripts/v03-baseline-session.js",
  "eval:baseline-v04": "node scripts/v04-baseline-session.js",
  "eval:release-gate": "node scripts/release-gate.js",
  "shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File ./create-shortcut.ps1",
  "shortcut:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File ./create-shortcut.ps1 -Mode Dev"
}
