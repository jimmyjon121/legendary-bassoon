{
  "name": "devforge",
  "version": "0.4.2",
  "description": "Sovereign AI Development Environment - Local, Private, Unrestricted",
  "main": "electron/main.js",
  "author": "Christopher",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "npm run app",
    "preapp": "node scripts/ensure-deps.js",
    "app:prepare": "node scripts/build-if-needed.js",
    "app": "npm run app:prepare && node scripts/launch-electron.js",
    "predev": "node scripts/ensure-deps.js",
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "prebuild": "node scripts/ensure-deps.js",
    "build:app": "vite build",
    "build": "vite build && electron-builder",
    "build:win": "vite build && electron-builder --win",
    "build:mac": "vite build && electron-builder --mac",
    "build:linux": "vite build && electron-builder --linux",
    "preview": "vite preview",
    "lint": "eslint src --ext .js,.jsx",
    "ensure-deps": "node scripts/ensure-deps.js",
    "eval:research": "node scripts/research-eval.js",
    "eval:casual": "node scripts/casual-eval.js",
    "eval:coding": "node scripts/coding-eval.js",
    "eval:chat-v2": "node scripts/chat-v2-eval.js",
    "eval:llm-mode": "node scripts/llm-mode-eval.js",
    "eval:live-chat-smoke": "node scripts/live-chat-smoke.js",
    "eval:perf-chat-stream": "node scripts/perf-chat-stream.js",
    "eval:perf-db-save": "node scripts/perf-db-save.js",
    "eval:perf-ui-polling": "node scripts/perf-ui-polling.js",
    "eval:perf-gate": "node scripts/release-perf-gate.js",
    "eval:model-hub": "node scripts/model-hub-eval.js",
    "eval:ipc-security": "node scripts/ipc-security-eval.js",
    "eval:long-context": "node scripts/long-context-eval.js",
    "eval:mode-switch": "node scripts/mode-switch-smoke.js",
    "eval:llamanode": "node scripts/llamanode-smoke.js",
    "eval:llamanode-live": "node scripts/llamanode-live-smoke.js",
    "eval:tiered-utilization": "node scripts/tiered-utilization-smoke.js",
    "eval:draft-selector": "node scripts/draft-selector-smoke.js",
    "eval:npu-draft": "node scripts/npu-draft-smoke.js",
    "eval:spec-verifier": "node scripts/spec-verifier-smoke.js",
    "eval:spec-bus": "node scripts/spec-bus-smoke.js",
    "eval:spec-dashboard": "node scripts/spec-dashboard-smoke.js",
    "eval:spec-decoding": "node scripts/speculative-decoding-eval.js",
    "eval:spec-live": "node scripts/spec-decode-live-smoke.js",
    "eval:v03-manual-qa": "node scripts/v03-manual-qa-harness.js",
    "eval:live-smoke": "node scripts/stream-cold-load-smoke.js && node scripts/npu-genai-smoke.js && node scripts/speculative-decoding-eval.js",
    "eval:baseline-v03": "node scripts/v03-baseline-session.js",
    "eval:baseline-v04": "node scripts/v04-baseline-session.js",
    "eval:release-gate": "node scripts/release-gate.js",
    "shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File ./create-shortcut.ps1",
    "shortcut:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File ./create-shortcut.ps1 -Mode Dev"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@react-three/postprocessing": "^3.0.4",
    "@tanstack/react-query": "^5.17.0",
    "@tanstack/react-virtual": "^3.13.19",
    "crypto-js": "^4.2.0",
    "date-fns": "^3.3.1",
    "dompurify": "^3.3.1",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.1.0",
    "framer-motion": "^12.23.25",
    "gsap": "^3.14.2",
    "highlight.js": "^11.9.0",
    "katex": "^0.16.28",
    "lucide-react": "^0.323.0",
    "mammoth": "^1.6.0",
    "marked": "^12.0.0",
    "monaco-editor": "^0.52.0",
    "node-llama-cpp": "3.18.1",
    "node-powershell": "^4.0.0",
    "pdf-parse": "^1.1.1",
    "puppeteer-core": "^24.32.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-resizable-panels": "^3.0.6",
    "react-router-dom": "^6.22.0",
    "reactflow": "^11.11.4",
    "simple-git": "^3.30.0",
    "sql.js": "^1.13.0",
    "sudo-prompt": "^9.2.1",
    "systeminformation": "^5.21.0",
    "three": "^0.182.0",
    "uuid": "^9.0.1",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "baseline-browser-mapping": "^2.9.19",
    "concurrently": "^8.2.2",
    "electron": "^32.3.3",
    "electron-builder": "^25.1.8",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "vite": "^5.1.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.devforge.app",
    "productName": "DevForge",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "electron/services/**",
      "node_modules/node-llama-cpp/**"
    ],
    "extraResources": [
      {
        "from": "openvino-env",
        "to": "openvino-env",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "scripts",
        "to": "scripts",
        "filter": [
          "setup-openvino.ps1",
          "start-npu-server.py",
          "openvino-model.json",
          "convert-to-openvino.py"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "verifyUpdateCodeSignature": false,
      "signAndEditExecutable": false,
      "signtoolOptions": {
        "publisherName": "DevForge"
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "DevForge",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "warningsAsErrors": false
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png",
      "category": "Development"
    }
  }
}
